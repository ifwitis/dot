#!/usr/bin/env bash

set -e

# Size threshold in MB
THRESHOLD_MB=50
THRESHOLD_BYTES=$((THRESHOLD_MB * 1024 * 1024))

changed=0

while IFS= read -r file; do
    [ -f "$file" ] || continue

    size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file")

    if [ "$size" -gt "$THRESHOLD_BYTES" ]; then
        ext="${file##*.}"

        if ! git lfs track "*.${ext}" >/dev/null 2>&1; then
            continue
        fi

        git add .gitattributes
        git add "$file"

        echo "Git LFS tracking enabled for *.$ext"
        changed=1
    fi
done < <(git diff --cached --name-only)

if [ "$changed" -eq 1 ]; then
    echo
    echo "Large files were detected and added to Git LFS."
    echo "Review .gitattributes and run git commit again."
    exit 1
fi

exit 0
