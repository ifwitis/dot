# Ghostty configuration
# https://ghostty.org/docs/config

keybind = global:alt+shift+t=toggle_quick_terminal

# Send escape sequences for Option as Meta
macos-option-as-alt = true
keybind = alt+left=text:\x1b[1;3D
keybind = alt+right=text:\x1b[1;3C
keybind = alt+up=text:\x1b[1;3A
keybind = alt+down=text:\x1b[1;3B
# Send Cmd+/ escape sequence as Ctrl+_, might change
keybind = cmd+/=text:\x1f

quick-terminal-size = 10%
quick-terminal-autohide = true

font-family = "LiterationMono Nerd Font Mono" 

# background = #000000
# foreground = #dadada
background-opacity = 0.85
bell-features = "no-title"
macos-titlebar-style = "transparent"
macos-titlebar-proxy-icon = "hidden"
title = " "

cursor-color = #dadada
selection-background = #454545
selection-foreground = #dadada

palette = 0=#000000
palette = 1=#ec2427
palette = 2=#45b64a
palette = 3=#edb41f
palette = 4=#4686c6
palette = 5=#f36525
palette = 6=#a4dde6
palette = 7=#dadada

palette = 8=#6e6a86
palette = 9=#ec2427
palette = 10=#45b64a
palette = 11=#F7EE49
palette = 12=#4686c6
palette = 13=#f36525
palette = 14=#a4dde6
palette = 15=#ffffff
