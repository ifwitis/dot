{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        // MIT Parley Configuration
        "mit-parley": {
            "name": "MIT Parley",
            "options": {
                "baseURL": "https://parley.api.mit.edu/v1",
                "apiKey": "{env:PARLEY_API_KEY}"
            },
            "models": {
                "openai/gpt-5.6-sol": {
                    "name": "GPT-5.6 Sol"
                },
                "openai/gpt-5.4-nano": {
                    "name": "GPT-5.4 nano"
                },
                "bedrock/claude-opus-4-8": {
                    "name": "Claude 4.8 Opus"
                },
            }
        },
        // Local Ollama Configuration
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama Local",
            "options": {
                // Automatically references your custom host variable, or defaults to localhost
                "baseURL": "{env:OLLAMA_HOST}/v1"
            },
            "models": {
                // LOCAL MODELS
                "qwen2.5-coder:latest": {
                    "name": "Qwen 2.5"
                },
            }
        }
    }
}

