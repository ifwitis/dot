# Include ~/.colima/ssh_config

# Personal / Redundant since configured in .gitconfig
Host ifwitis.github.com
    User git
    HostName github.com
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_personal
    SetEnv TERM=xterm-256color

# Work
Host work.github.com
    User git
    HostName github.com
    AddKeysToAgent yes
    UseKeychain yes
    IdentityFile ~/.ssh/id_work
    IdentitiesOnly yes

# CTF Practice
Host dojo.pwn.college
    AddKeysToAgent yes
    IdentityFile ~/.ssh/ctfs/prac_key 
    IdentitiesOnly yes

